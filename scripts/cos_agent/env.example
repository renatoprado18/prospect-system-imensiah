# Copie pra ~/.cos-agent/env e faca chmod 600. FORA do repo de proposito.
#
# COS_RO_URL    -> papel `cos_agent_ro`: LE tudo, NAO escreve nada.
#                  Negado pelo Postgres, nao por instrucao no prompt. E a unica
#                  credencial que entra no ambiente do agente.
# COS_OWNER_URL -> so o runner usa, pra gravar cos_daily_review + cron_heartbeats.
#                  E removida do ambiente do subprocesso do agente.
export COS_RO_URL='postgresql://cos_agent_ro:SENHA@HOST/neondb?sslmode=require'
export COS_OWNER_URL='postgresql://neondb_owner:SENHA@HOST/neondb?sslmode=require'
