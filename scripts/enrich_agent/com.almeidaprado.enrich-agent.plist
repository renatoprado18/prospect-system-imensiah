<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enriquecimento de contatos como agente local — job do launchd.

  Instalar:
    cp scripts/enrich_agent/com.almeidaprado.enrich-agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.almeidaprado.enrich-agent.plist
  Disparar a mao (teste):
    launchctl kickstart -k gui/$(id -u)/com.almeidaprado.enrich-agent
  Desligar:
    launchctl bootout gui/$(id -u)/com.almeidaprado.enrich-agent

  HORARIO: 07:40 BRT. Tres restricoes, nesta ordem:

  · DEPOIS do `pmset repeat wakeorpoweron 07:10`, que e o que acorda a maquina.
    Um job agendado antes disso so roda se o Mac ja estiver acordado — e na
    bateria ele dorme em 1 minuto.
  · DEPOIS do cos-agent das 07:12, que leva ~10 min. Os dois consomem a MESMA
    cota do Max, que e a mesma que o Renato usa pra trabalhar; sobrepor os dois
    e disputar com ele.
  · ANTES do cron `run-auto-enrich`, movido para 12:00 UTC (09:00 BRT) no mesmo
    commit. A ordem importa: enquanto o cron rodava as 02:25 ele esvaziava a
    fila antes de o Mac acordar, e este job bateria ponto todo dia sobre
    trabalho nenhum — saudavel na aparencia, inutil no efeito.

  `--limit 5`: a fila real e de ~53 contatos em circulo 1-2, re-enriquecidos a
  cada 30 dias — cerca de 2 por dia em regime permanente. O teto de 5 cobre o
  regime e a fila represada sem comer a cota que o Renato usa pra trabalhar.
  Medido em 10/08: UM contato de 26 mil interacoes levou 153s.

  SONO DA MAQUINA: mesma armadilha do cos-agent. Na bateria o Mac dorme em 1
  minuto e o job nao acontece. O `pmset repeat wakeorpoweron 07:10` que ja existe
  cobre este job, que roda 30 min depois — nao e preciso mexer no pmset.

  COMO SE SABE QUE NAO RODOU: batimento em `cron_heartbeats`
  (job_id=enrich-agent-local). A deteccao mora no SERVIDOR — vigia que mora na
  maquina que caiu nao vigia nada.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.almeidaprado.enrich-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; . "$HOME/.cos-agent/env"; set +a; exec /Users/rap/prospect-system/.venv/bin/python /Users/rap/prospect-system/scripts/enrich_agent/run.py --limit 5</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/rap/prospect-system/scripts/enrich_agent</string>

  <key>StandardOutPath</key>
  <string>/Users/rap/.cos-agent/enrich.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rap/.cos-agent/enrich.err</string>

  <key>ExitTimeOut</key>
  <integer>1800</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
